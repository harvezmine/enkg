# Disalin otomatis ke /var/www/enkg/.env.production oleh deploy/setup-server.sh (chmod 600).

# Domain publik situs — dipakai untuk canonical, sitemap, OG image, dan JSON-LD.
# Ditanam ke bundel saat build: setelah diubah, jalankan ulang deploy/deploy.sh.
NEXT_PUBLIC_SITE_URL=https://everynationkg.com

# Port lokal server Node (nginx meneruskan ke sini). Samakan dengan deploy/nginx.conf.
PORT=3001

# ── Admin panel (/admin) ─────────────────────────────────────────────────────
# Boleh memakai project Supabase yang sama dengan situs Janji Pengharapan (jp/):
# semua tabel ENKG berawalan enkg_. Jalankan supabase/schema.sql sekali di SQL Editor.
# Kalau dikosongkan, situs tetap jalan dengan konten statis dan /admin menampilkan
# petunjuk konfigurasi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RAHASIA: melewati RLS. Hanya dipakai di server, jangan pernah diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Kata sandi bersama pengurus, minimal 12 karakter. Samakan dengan jp/.env untuk satu sandi.
# Mengganti sandi otomatis mengeluarkan semua sesi admin yang sedang login.
ADMIN_PASSWORD=
